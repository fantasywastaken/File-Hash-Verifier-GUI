<Window x:Class="Fantasy.FileHashVerifier.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File Hash Verifier"
        Height="720"
        Width="1180"
        MinHeight="560"
        MinWidth="900"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="File Hash Verifier"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource ForegroundBrushColor}"
                       Margin="0,0,0,4"/>

            <TextBlock Grid.Row="1"
                       Text="Compute and verify cryptographic hashes"
                       FontSize="12"
                       Foreground="{StaticResource SubtleForegroundBrush}"
                       Margin="0,0,0,16"/>

            <Border x:Name="DropZone"
                    Grid.Row="2"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrushColor}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Height="120"
                    AllowDrop="True"
                    Drop="DropZone_Drop"
                    DragEnter="DropZone_DragEnter"
                    DragLeave="DropZone_DragLeave"
                    DragOver="DropZone_DragOver">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Drop files here"
                               FontSize="15"
                               FontWeight="Medium"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource ForegroundBrushColor}"/>
                    <TextBlock Text="or use the Browse button below"
                               FontSize="11"
                               Margin="0,4,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource SubtleForegroundBrush}"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="3" Margin="0,12,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="Browse Files"
                        Click="BrowseButton_Click"/>
                <Button Grid.Column="2"
                        Content="Clear"
                        Style="{StaticResource SubtleButton}"
                        Click="ClearButton_Click"/>
            </Grid>

            <ListBox Grid.Row="4"
                     x:Name="FilesListBox"
                     SelectionChanged="FilesListBox_SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>

            <TextBlock Grid.Row="5"
                       x:Name="FileCountLabel"
                       Text="0 files"
                       FontSize="11"
                       Margin="0,8,0,0"
                       Foreground="{StaticResource SubtleForegroundBrush}"/>
        </Grid>

        <Border Grid.Column="2"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrushColor}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Selected File"
                               FontSize="11"
                               Foreground="{StaticResource SubtleForegroundBrush}"
                               Margin="0,0,0,4"/>
                    <TextBlock x:Name="SelectedFileName"
                               Text="No file selected"
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource ForegroundBrushColor}"/>
                    <TextBlock x:Name="SelectedFilePath"
                               Text=""
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource SubtleForegroundBrush}"
                               Margin="0,2,0,0"/>
                    <TextBlock x:Name="SelectedFileSize"
                               Text=""
                               FontSize="11"
                               Foreground="{StaticResource SubtleForegroundBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <ProgressBar Grid.Row="1"
                             x:Name="ComputeProgress"
                             IsIndeterminate="True"
                             Visibility="Collapsed"
                             Margin="0,16,0,0"/>

                <TextBlock Grid.Row="2"
                           x:Name="ComputeStatusLabel"
                           Text=""
                           FontSize="11"
                           Margin="0,8,0,0"
                           Foreground="{StaticResource SubtleForegroundBrush}"/>

                <StackPanel Grid.Row="3" Margin="0,20,0,0">
                    <TextBlock Text="Hash Values"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ForegroundBrushColor}"
                               Margin="0,0,0,10"/>

                    <Border x:Name="Md5Row"
                            Background="{StaticResource ControlBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrushColor}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12,10"
                            Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="MD5"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource ForegroundBrushColor}"/>
                            <TextBox Grid.Column="1"
                                     x:Name="Md5TextBox"
                                     IsReadOnly="True"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     VerticalAlignment="Center"/>
                            <Button Grid.Column="2"
                                    Content="Copy"
                                    Style="{StaticResource SubtleButton}"
                                    Tag="MD5"
                                    Click="CopyButton_Click"
                                    Margin="8,0,0,0"/>
                        </Grid>
                    </Border>

                    <Border x:Name="Sha1Row"
                            Background="{StaticResource ControlBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrushColor}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12,10"
                            Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="SHA1"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource ForegroundBrushColor}"/>
                            <TextBox Grid.Column="1"
                                     x:Name="Sha1TextBox"
                                     IsReadOnly="True"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     VerticalAlignment="Center"/>
                            <Button Grid.Column="2"
                                    Content="Copy"
                                    Style="{StaticResource SubtleButton}"
                                    Tag="SHA1"
                                    Click="CopyButton_Click"
                                    Margin="8,0,0,0"/>
                        </Grid>
                    </Border>

                    <Border x:Name="Sha256Row"
                            Background="{StaticResource ControlBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrushColor}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12,10"
                            Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="SHA256"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource ForegroundBrushColor}"/>
                            <TextBox Grid.Column="1"
                                     x:Name="Sha256TextBox"
                                     IsReadOnly="True"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     VerticalAlignment="Center"/>
                            <Button Grid.Column="2"
                                    Content="Copy"
                                    Style="{StaticResource SubtleButton}"
                                    Tag="SHA256"
                                    Click="CopyButton_Click"
                                    Margin="8,0,0,0"/>
                        </Grid>
                    </Border>

                    <Border x:Name="Sha512Row"
                            Background="{StaticResource ControlBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrushColor}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="SHA512"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource ForegroundBrushColor}"/>
                            <TextBox Grid.Column="1"
                                     x:Name="Sha512TextBox"
                                     IsReadOnly="True"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     VerticalAlignment="Center"/>
                            <Button Grid.Column="2"
                                    Content="Copy"
                                    Style="{StaticResource SubtleButton}"
                                    Tag="SHA512"
                                    Click="CopyButton_Click"
                                    Margin="8,0,0,0"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <Grid Grid.Row="5" Margin="0,24,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="Verify Against Expected Hash"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ForegroundBrushColor}"
                               Margin="0,0,0,10"/>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 x:Name="ExpectedHashTextBox"
                                 FontFamily="Consolas"
                                 FontSize="12"/>
                        <ComboBox Grid.Column="2"
                                  x:Name="AlgoComboBox"
                                  SelectedIndex="2">
                            <ComboBoxItem Content="MD5"/>
                            <ComboBoxItem Content="SHA1"/>
                            <ComboBoxItem Content="SHA256"/>
                            <ComboBoxItem Content="SHA512"/>
                        </ComboBox>
                        <Button Grid.Column="4"
                                Content="Verify"
                                Click="VerifyButton_Click"/>
                    </Grid>
                    <TextBlock Grid.Row="2"
                               x:Name="VerifyStatusLabel"
                               Text=""
                               FontSize="13"
                               FontWeight="SemiBold"
                               Margin="0,12,0,0"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
